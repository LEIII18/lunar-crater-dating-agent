# Copy these names to PyCharm Run/Debug Configuration > Environment variables,
# or set them in your operating-system environment. Never commit a real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

ARCPY_PYTHON=<absolute path to ArcGIS 10.8 / ArcPy Python 2.7 python.exe>
CRATER_MODEL_PYTHON=<absolute path to the crater-detection model environment python.exe>
CRATER_MODEL_DIR=<absolute path to the crater_detect_model directory>
CRATER_OUTPUT_ROOT=<absolute path to the task-output root directory>
